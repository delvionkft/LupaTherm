# MINTA — ez a fájl a repóban van, de VALÓDI ÉRTÉKET SOHA NE ÍRJ BELE.
# A valódi értékek kizárólag a Vercel Environment Variables felületén élnek.
# Helyi fejlesztéshez másold .env.local néven (azt a .gitignore kizárja).

# Resend API-kulcs. TITKOS. Forrás: resend.com -> API Keys
RESEND_API_KEY=

# Ide érkeznek az ajánlatkérések. Nem titkos, de szerveroldali:
# a kliens nem adhat meg címzettet.
LEAD_TO_EMAIL=

# Feladó. A domainnek igazoltnak kell lennie a Resendben.
LEAD_FROM_EMAIL=

# Cloudflare Turnstile titkos kulcs. TITKOS.
# Ha üres, a CAPTCHA-ellenőrzés kimarad (a méhkas és a rate limit ilyenkor is véd).
TURNSTILE_SECRET_KEY=
